#!/usr/bin/env bash

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)

matches() { grep -qE "$1" <<<"$staged"; }

checks=()
if [[ "${DIFFPACK_HOOK_ALL:-0}" == "1" ]]; then
  checks=(fmt seams clippy deny audit test conformance)
else
  if matches '(\.rs$|^scripts/check-.*seams?\.sh$)'; then
    checks+=(seams)
  fi

  if matches '(\.rs$|^Cargo\.(toml|lock)$|^rust-toolchain\.toml$)'; then
    checks+=(fmt clippy)
  fi

  if matches '^(Cargo\.(toml|lock)|deny\.toml)$'; then
    checks+=(deny audit)
  fi

  if matches '(\.rs$|^Cargo\.(toml|lock)$|^rust-toolchain\.toml$|^fixtures/|^vercel\.json$)'; then
    checks+=(test)
  fi

  if matches '^(conformance/|scripts/conformance\.sh$|examples/serve\.rs$)'; then
    checks+=(conformance)
  fi
fi

if [[ ${#checks[@]} -eq 0 ]]; then
  echo "pre-commit: nothing staged that needs a Rust check"
  exit 0
fi

if ! git diff --quiet; then
  echo "pre-commit: note - there are unstaged changes; these checks see the working tree" >&2
fi

./scripts/checks.sh "${checks[@]}" || {
  cat >&2 <<'EOF'

The commit was not made. Fix the above, or commit with --no-verify if this is
a work-in-progress commit on a branch - CI runs the same checks on the pull
request either way.
EOF
  exit 1
}
